<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RootNamespace>OarTool</RootNamespace>
    <AssemblyName>OAR External Tool</AssemblyName>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>app_icon.ico</ApplicationIcon>
    <Version>2.0.0</Version>
    <Product>OAR External Tool</Product>
    <Authors>Smooth</Authors>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3719.77" />
  </ItemGroup>

  <ItemGroup>
    <!-- The page is served from this folder through a WebView2 virtual host (no local port). -->
    <Content Include="web\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="app_icon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Compile Remove="mockup\**;tests\**;tools\**;Release_Build\**" />
    <None Remove="mockup\**;tests\**;tools\**" />
  </ItemGroup>

</Project>
